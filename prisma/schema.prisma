// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  USER
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  QUEUE_CHANGED
  PRIORITY_CHANGED
  TEAM_CHANGED
  COMMENTED
  RESOLVED
  CLOSED
}

enum CalendarEventType {
  EVENT
  MEETING
  REMINDER
  FOCUS
}

enum CalendarEventVisibility {
  INVITE_ONLY
  ORGANIZATION
  TEAMS
}

enum CalendarEventStatus {
  CONFIRMED
  CANCELLED
}

enum CalendarParticipantResponse {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum CalendarRecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ChatChannelType {
  ORGANIZATION
  TEAM
  PRIVATE
  DIRECT
}

model User {
  id           String   @id @default(uuid())
  name         String?
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions                UserSession[]
  landingPages            LandingPage[]
  projects                Project[]
  tasks                   Task[]                     @relation("TaskOwner")
  tasksCreated            Task[]                     @relation("TaskCreator")
  tasksAssigned           Task[]                     @relation("TaskAssignee")
  taskTemplates           TaskTemplate[]
  timeEntries             TimeEntry[]
  notes                   Note[]
  noteFolders             NoteFolder[]
  noteAttachments         NoteAttachment[]
  noteComments            NoteComment[]              @relation("NoteCommentAuthor")
  dailyRoutines           DailyRoutine[]
  dailyRoutineSchedules   DailyRoutineSchedule[]
  routineDateOverrides    RoutineDateOverride[]
  dailyChecklistItems     DailyChecklistItem[]
  dailyChecklistEntries   DailyChecklistEntry[]
  activityLogs            TaskActivityLog[]
  organizationMemberships OrganizationMember[]
  organizationsCreated    Organization[]             @relation("OrganizationCreator")
  requestedTickets        Ticket[]                   @relation("TicketRequester")
  assignedTickets         Ticket[]                   @relation("TicketAssignee")
  ticketActivities        TicketActivity[]           @relation("TicketActivityActor")
  calendarEventsCreated   CalendarEvent[]            @relation("CalendarEventCreator")
  calendarParticipations  CalendarEventParticipant[]
  chatChannelsCreated     ChatChannel[]              @relation("ChatChannelCreator")
  chatMessages            ChatMessage[]              @relation("ChatMessageAuthor")
  chatUserMentions        ChatMessageUserMention[]
}

model UserSession {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  avatarUrl   String?
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy        User                     @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members          OrganizationMember[]
  teams            Team[]
  ticketQueues     TicketQueue[]
  tickets          Ticket[]
  tasks            Task[]
  notes            Note[]
  noteFolders      NoteFolder[]
  noteAttachments  NoteAttachment[]
  noteComments     NoteComment[]
  calendarEvents   CalendarEvent[]
  calendarTeams    CalendarEventTeam[]
  chatChannels     ChatChannel[]
  chatMessages     ChatMessage[]
  chatTeamMentions ChatMessageTeamMention[]

  @@index([createdById])
  @@index([active, name])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMemberships  TeamMember[]
  queueMemberships TicketQueueAgent[]
  chatMemberships  ChatChannelMember[]
  chatReadStates   ChatChannelReadState[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?  @db.Text
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members          TeamMember[]
  ticketQueues     TicketQueue[]
  tasks            Task[]
  tickets          Ticket[]
  calendarEvents   CalendarEventTeam[]
  chatChannels     ChatChannel[]
  chatTeamMentions ChatMessageTeamMention[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model TeamMember {
  id             String   @id @default(uuid())
  organizationId String
  teamId         String
  userId         String
  createdAt      DateTime @default(now())

  team               Team               @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([organizationId, userId])
  @@index([organizationId, teamId])
}

model TicketQueue {
  id             String   @id @default(uuid())
  organizationId String
  teamId         String?
  name           String
  description    String?  @db.Text
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?              @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  agents       TicketQueueAgent[]
  tickets      Ticket[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, active])
  @@index([organizationId, teamId])
}

model TicketQueueAgent {
  id             String   @id @default(uuid())
  organizationId String
  queueId        String
  userId         String
  createdAt      DateTime @default(now())

  queue              TicketQueue        @relation(fields: [queueId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([queueId, userId])
  @@index([organizationId, userId])
  @@index([organizationId, queueId])
}

model Ticket {
  id             String         @id @default(uuid())
  organizationId String
  queueId        String
  requesterId    String
  assigneeId     String?
  teamId         String?
  linkedTaskId   String?        @unique
  title          String
  description    String         @db.Text
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queue          TicketQueue      @relation(fields: [queueId, organizationId], references: [id, organizationId], onDelete: Restrict)
  requester      User             @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee       User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team           Team?            @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  linkedTask     Task?            @relation("TicketLinkedTask", fields: [linkedTaskId], references: [id], onDelete: SetNull)
  activities     TicketActivity[]
  calendarEvents CalendarEvent[]

  @@index([organizationId, status])
  @@index([organizationId, queueId, status])
  @@index([organizationId, teamId, status])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, requesterId])
  @@index([organizationId, priority])
  @@index([updatedAt])
}

model TicketActivity {
  id        String             @id @default(uuid())
  ticketId  String
  actorId   String?
  type      TicketActivityType
  message   String
  before    Json?
  after     Json?
  comment   String?            @db.Text
  createdAt DateTime           @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation("TicketActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([actorId])
  @@index([type])
}

model LandingPage {
  id             String   @id @default(uuid())
  userId         String
  name           String
  slug           String   @unique
  description    String
  avatarImageUrl String
  coverImageUrl  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactInfo        ContactInfo?
  portfolioContent   PortfolioContent?
  projects           Project[]
  pageViews          PageView[]
  socialInteractions SocialInteraction[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model PortfolioContent {
  id            String   @id @default(uuid())
  landingpageId String   @unique
  hero          Json?
  about         Json?
  services      Json?
  process       Json?
  contact       Json?
  projects      Json?
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  landingpage LandingPage @relation(fields: [landingpageId], references: [id], onDelete: Cascade)
}

model ContactInfo {
  id            String  @id @default(uuid())
  email         String
  phone         String?
  whatsappLink  String?
  instagramLink String?
  facebookLink  String?
  linkedinLink  String?

  // Relations
  landingpage   LandingPage @relation(fields: [landingpageId], references: [id], onDelete: Cascade)
  landingpageId String      @unique
}

// Adicione o relacionamento no modelo Project existente
model Project {
  id              String   @id @default(uuid())
  userId          String
  title           String
  category        String
  description     String
  fullDescription String
  image           String
  technologies    String[]
  liveUrl         String?
  githubUrl       String?
  featured        Boolean  @default(false)
  isActive        Boolean  @default(true)
  status          String   @default("completed")
  accentColor     String?  @default("from-gray-500/20 to-gray-600/20")
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  landingpage   LandingPage @relation(fields: [landingpageId], references: [id], onDelete: Cascade)
  landingpageId String

  // Adicione esta relação para tasks
  tasks          Task[] // Relacionamento com tasks
  features       Feature[]
  sprints        Sprint[]
  notes          Note[]
  calendarEvents CalendarEvent[]

  @@index([userId])
  @@index([userId, position])
  @@index([userId, isActive])
}

// Modelo para administrador
model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String // Armazenaremos hash da senha
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Adicione estes modelos ao seu schema.prisma

// Modelo para rastreamento de visualizações
model PageView {
  id        String   @id @default(uuid())
  page      String // Ex: 'home', 'projects', 'about'
  path      String // URL completa
  ip        String?
  userAgent String?
  country   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  landingpage   LandingPage @relation(fields: [landingpageId], references: [id], onDelete: Cascade)
  landingpageId String
}

// Modelo para interações sociais
model SocialInteraction {
  id        String   @id @default(uuid())
  platform  String // 'linkedin', 'github', 'instagram', etc
  type      String // 'follow', 'like', 'comment', 'share'
  content   String? // Conteúdo do comentário, etc
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  landingpage   LandingPage @relation(fields: [landingpageId], references: [id], onDelete: Cascade)
  landingpageId String

  @@unique([platform, type, landingpageId, createdAt])
}

// Modelo para Features
model Feature {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("planning") // planning, in-progress, completed, cancelled
  priority    String   @default("medium") // low, medium, high, urgent
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

// Modelo para Sprints
model Sprint {
  id          String   @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("planning") // planning, active, completed
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

// Template de Tarefas
model TaskTemplate {
  id             String   @id @default(uuid())
  userId         String
  name           String
  description    String?
  status         String   @default("pending")
  priority       String   @default("medium")
  estimatedHours Float?   @default(0)
  tags           String[] // Array de tags
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

// Time Tracking
model TimeEntry {
  id          String   @id @default(uuid())
  taskId      String
  userId      String
  description String?
  hours       Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, taskId])
  @@index([userId, date])
}

// Task Dependency
model TaskDependency {
  id             String @id @default(uuid())
  taskId         String
  dependsOnId    String
  dependencyType String @default("blocks") // blocks, relates_to

  task      Task @relation("TaskDependencies", fields: [taskId], references: [id])
  dependsOn Task @relation("DependsOnTasks", fields: [dependsOnId], references: [id])

  @@unique([taskId, dependsOnId])
}

model Task {
  id             String    @id @default(uuid())
  userId         String
  organizationId String?
  teamId         String?
  createdById    String?
  assigneeId     String?
  title          String
  description    String?
  status         String    @default("pending")
  priority       String    @default("medium")
  dueDate        DateTime?
  estimatedHours Float?    @default(0)
  actualHours    Float?    @default(0)
  position       Int       @default(0)

  tags          String[]  @default([])
  recurrence    String?
  recurrenceEnd DateTime?
  completedAt   DateTime?
  noteTaskKey   String?

  // Novas relações
  templateId   String?
  template     TaskTemplate?     @relation(fields: [templateId], references: [id])
  timeEntries  TimeEntry[]
  dependencies TaskDependency[]  @relation("TaskDependencies")
  dependedOnBy TaskDependency[]  @relation("DependsOnTasks")
  activityLogs TaskActivityLog[]

  // Relacionamentos
  projectId String?
  featureId String?
  sprintId  String?
  parentId  String?
  noteId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  user           User            @relation("TaskOwner", fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?           @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy      User?           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  feature        Feature?        @relation(fields: [featureId], references: [id], onDelete: SetNull)
  sprint         Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  note           Note?           @relation(fields: [noteId], references: [id], onDelete: SetNull)
  parent         Task?           @relation("TaskToSubtask", fields: [parentId], references: [id])
  subtasks       Task[]          @relation("TaskToSubtask")
  linkedTicket   Ticket?         @relation("TicketLinkedTask")
  calendarEvents CalendarEvent[]

  @@unique([noteId, noteTaskKey])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, projectId])
  @@index([userId, sprintId])
  @@index([userId, noteId])
  @@index([userId, updatedAt])
  @@index([organizationId, status])
  @@index([organizationId, teamId, status])
  @@index([organizationId, assigneeId, status])
  @@index([createdById])
}

model CalendarEvent {
  id                  String                      @id @default(uuid())
  title               String
  description         String?                     @db.Text
  startAt             DateTime
  endAt               DateTime
  allDay              Boolean                     @default(false)
  timezone            String
  creatorId           String
  organizationId      String?
  location            String?
  meetingUrl          String?
  type                CalendarEventType           @default(EVENT)
  visibility          CalendarEventVisibility     @default(INVITE_ONLY)
  status              CalendarEventStatus         @default(CONFIRMED)
  recurrenceFrequency CalendarRecurrenceFrequency @default(NONE)
  recurrenceInterval  Int                         @default(1)
  recurrenceWeekdays  Int[]                       @default([])
  recurrenceUntil     DateTime?
  taskId              String?
  ticketId            String?
  projectId           String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  creator        User                       @relation("CalendarEventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  organization   Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants   CalendarEventParticipant[]
  teams          CalendarEventTeam[]
  task           Task?                      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  ticket         Ticket?                    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  project        Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sharedMessages ChatMessage[]

  @@unique([id, organizationId])
  @@index([creatorId, startAt])
  @@index([organizationId, startAt])
  @@index([startAt, endAt])
  @@index([recurrenceFrequency, recurrenceUntil])
  @@index([taskId])
  @@index([ticketId])
  @@index([projectId])
}

model CalendarEventParticipant {
  id          String                      @id @default(uuid())
  eventId     String
  userId      String
  response    CalendarParticipantResponse @default(PENDING)
  invitedAt   DateTime                    @default(now())
  respondedAt DateTime?

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, response])
}

model CalendarEventTeam {
  id             String @id @default(uuid())
  eventId        String
  organizationId String
  teamId         String

  event        CalendarEvent @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team          @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([eventId, teamId])
  @@index([organizationId, teamId])
}

model ChatChannel {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  description    String?         @db.Text
  type           ChatChannelType
  teamId         String?
  directKey      String?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?                  @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy    User                   @relation("ChatChannelCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members      ChatChannelMember[]
  messages     ChatMessage[]
  readStates   ChatChannelReadState[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@unique([organizationId, directKey])
  @@index([organizationId, type])
  @@index([organizationId, teamId])
}

model ChatChannelMember {
  id             String   @id @default(uuid())
  channelId      String
  organizationId String
  userId         String
  createdAt      DateTime @default(now())

  channel            ChatChannel        @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([organizationId, userId])
}

model ChatMessage {
  id             String    @id @default(uuid())
  channelId      String
  organizationId String
  authorId       String
  content        String    @db.Text
  replyToId      String?
  eventId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  editedAt       DateTime?
  deletedAt      DateTime?

  channel      ChatChannel              @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User                     @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  replyTo      ChatMessage?             @relation("ChatThread", fields: [replyToId], references: [id], onDelete: Cascade)
  replies      ChatMessage[]            @relation("ChatThread")
  event        CalendarEvent?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  userMentions ChatMessageUserMention[]
  teamMentions ChatMessageTeamMention[]

  @@unique([id, organizationId])
  @@index([channelId, createdAt])
  @@index([organizationId, authorId, createdAt])
  @@index([replyToId, createdAt])
  @@index([eventId])
}

model ChatMessageUserMention {
  id             String @id @default(uuid())
  messageId      String
  organizationId String
  userId         String

  message ChatMessage @relation(fields: [messageId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([organizationId, userId])
}

model ChatMessageTeamMention {
  id             String @id @default(uuid())
  messageId      String
  organizationId String
  teamId         String

  message      ChatMessage  @relation(fields: [messageId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([messageId, teamId])
  @@index([organizationId, teamId])
}

model ChatChannelReadState {
  id                String   @id @default(uuid())
  channelId         String
  organizationId    String
  userId            String
  lastReadAt        DateTime @default(now())
  lastReadMessageId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  channel            ChatChannel        @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([organizationId, userId])
}

model DailyRoutine {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String?
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     DailyChecklistItem[]
  schedules DailyRoutineSchedule[]
  overrides RoutineDateOverride[]
  entries   DailyChecklistEntry[]

  @@unique([id, userId])
  @@unique([userId, name])
  @@index([userId, active])
  @@index([userId, isDefault])
}

model DailyRoutineSchedule {
  id        String   @id @default(uuid())
  userId    String
  routineId String
  weekday   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine DailyRoutine @relation(fields: [routineId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, weekday])
  @@index([routineId])
}

model RoutineDateOverride {
  id        String   @id @default(uuid())
  userId    String
  routineId String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine DailyRoutine @relation(fields: [routineId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, date])
  @@index([routineId, date])
}

model DailyChecklistItem {
  id          String   @id @default(uuid())
  userId      String
  routineId   String
  slug        String
  title       String
  description String
  period      String
  timeRange   String
  startTime   String?
  endTime     String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  isSacred    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine      DailyRoutine          @relation(fields: [routineId, userId], references: [id, userId], onDelete: Restrict)
  entries      DailyChecklistEntry[]
  activityLogs TaskActivityLog[]

  @@unique([id, userId])
  @@unique([userId, routineId, slug])
  @@index([userId])
  @@index([routineId, active])
  @@index([routineId, period])
  @@index([routineId, position])
}

model DailyChecklistEntry {
  id                      String    @id @default(uuid())
  userId                  String
  routineId               String
  itemId                  String
  date                    DateTime
  completed               Boolean   @default(false)
  completedAt             DateTime?
  note                    String?
  routineNameSnapshot     String
  itemTitleSnapshot       String
  itemDescriptionSnapshot String
  periodSnapshot          String
  timeRangeSnapshot       String
  startTimeSnapshot       String?
  endTimeSnapshot         String?
  positionSnapshot        Int
  isSacredSnapshot        Boolean
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine DailyRoutine       @relation(fields: [routineId, userId], references: [id, userId], onDelete: Restrict)
  item    DailyChecklistItem @relation(fields: [itemId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, itemId, date])
  @@index([userId])
  @@index([userId, date])
  @@index([routineId, date])
}

model TaskActivityLog {
  id                   String   @id @default(uuid())
  userId               String
  taskId               String?
  dailyChecklistItemId String?
  type                 String
  message              String
  metadata             Json?
  createdAt            DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  task               Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  dailyChecklistItem DailyChecklistItem? @relation(fields: [dailyChecklistItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, taskId])
  @@index([userId, dailyChecklistItemId])
  @@index([userId, type])
}

enum NoteVisibility {
  PUBLIC
  PRIVATE
}

enum NoteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Note {
  id                String         @id @default(uuid())
  userId            String
  organizationId    String?
  scopeKey          String
  title             String
  slug              String
  content           String         @db.Text
  excerpt           String?
  visibility        NoteVisibility @default(PRIVATE)
  status            NoteStatus     @default(DRAFT)
  statusBeforeTrash NoteStatus?
  trashedAt         DateTime?

  isFavorite Boolean @default(false)
  viewCount  Int     @default(0)

  fileName   String?
  filePath   String?
  folderPath String?
  folderName String?
  folderId   String?
  extension  String?
  importedAt DateTime?
  position   Int       @default(0)

  projectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folder       NoteFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  tags     NoteTag[]
  outgoing NoteLink[]    @relation("SourceLinks")
  incoming NoteLink[]    @relation("TargetLinks")
  tasks    Task[]
  comments NoteComment[]

  @@unique([id, organizationId])
  @@unique([scopeKey, slug])
  @@unique([scopeKey, filePath])
  @@index([userId])
  @@index([organizationId])
  @@index([scopeKey])
  @@index([userId, visibility])
  @@index([userId, status])
  @@index([userId, trashedAt])
  @@index([userId, projectId])
  @@index([userId, folderPath])
  @@index([userId, folderId])
  @@index([userId, position])
  @@index([userId, updatedAt])
}

model NoteFolder {
  id                  String    @id @default(uuid())
  userId              String
  organizationId      String?
  scopeKey            String
  name                String
  path                String
  parentId            String?
  position            Int       @default(0)
  deletedAt           DateTime?
  trashedAt           DateTime?
  pathBeforeTrash     String?
  parentIdBeforeTrash String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       NoteFolder?   @relation("NoteFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     NoteFolder[]  @relation("NoteFolderTree")
  notes        Note[]

  @@unique([scopeKey, path])
  @@index([userId])
  @@index([organizationId])
  @@index([scopeKey])
  @@index([userId, parentId])
  @@index([userId, position])
  @@index([userId, deletedAt])
  @@index([userId, trashedAt])
}

model NoteAttachment {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?
  scopeKey       String
  fileName       String
  filePath       String
  folderPath     String?
  folderName     String?
  extension      String?
  mimeType       String?
  size           Int?
  dataUrl        String?  @db.Text
  importedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, filePath])
  @@index([userId])
  @@index([organizationId])
  @@index([scopeKey])
  @@index([userId, folderPath])
  @@index([userId, fileName])
}

model NoteComment {
  id             String   @id @default(uuid())
  noteId         String
  organizationId String
  authorId       String
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  note         Note         @relation(fields: [noteId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("NoteCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, noteId, createdAt])
  @@index([authorId])
}

model NoteTag {
  id        String   @id @default(uuid())
  noteId    String
  name      String
  slug      String
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, slug])
  @@index([slug])
  @@index([name])
}

model NoteLink {
  id           String   @id @default(uuid())
  sourceNoteId String
  targetNoteId String?
  targetSlug   String
  targetTitle  String
  alias        String?
  occurrences  Int      @default(1)
  targetExists Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sourceNote Note  @relation("SourceLinks", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote Note? @relation("TargetLinks", fields: [targetNoteId], references: [id], onDelete: SetNull)

  @@unique([sourceNoteId, targetSlug])
  @@index([targetNoteId])
  @@index([targetSlug])
  @@index([targetExists])
}
